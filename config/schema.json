{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/tauri-go-service-example/config.schema.json",
  "title": "Task service configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["app", "database", "server", "ui"],
  "properties": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "logLevel"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1 } }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "host", "port", "allowedOrigins", "requestTimeout", "shutdownTimeout"],
      "properties": {
        "mode": { "enum": ["desktop", "remote"] },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "allowedOrigins": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true },
        "requestTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$" },
        "shutdownTimeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m)$" }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appName", "pageSize"],
      "properties": {
        "appName": { "type": "string", "minLength": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
